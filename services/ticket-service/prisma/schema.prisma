generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id         Int      @id @default(autoincrement())
  tripId     Int      @map("trip_id")
  userId     String   @map("user_id")
  seatNumber Int      @map("seat_number")
  price      Float
  status     String   @default("ACTIVE")
  saleDate   DateTime @map("sale_date")
  passengerName String?   @map("passenger_name")
  paymentMethod String?   @map("payment_method")
  amountReceived Float?   @map("amount_received")
  changeGiven    Float?   @map("change_given")
  cardLast4      String?  @map("card_last4")
  
  createdAt  DateTime @map("created_at") @default(now())
  updatedAt  DateTime @map("updated_at") @updatedAt

  @@unique([tripId, seatNumber], name: "unique_seat_per_trip")
  @@map("tickets")
}

model Trip {
  id            Int      @id @default(autoincrement())
  routeId       Int      @map("route_id")
  departureTime DateTime @map("departure_time")
  status        String   @default("SCHEDULED")

  @@map("trips")
}
