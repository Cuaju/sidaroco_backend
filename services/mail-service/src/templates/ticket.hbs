<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your SIDAROCO Tickets</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f5f5f5;
      margin: 0;
      padding: 20px;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }
    .header {
      background: linear-gradient(135deg, #14532d, #22c55e);
      color: white;
      padding: 30px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 900;
    }
    .header p {
      margin: 8px 0 0;
      opacity: 0.9;
      font-size: 14px;
    }
    .trip-info {
      background: #f0fdf4;
      padding: 24px 30px;
      border-bottom: 1px solid #e0e0e0;
    }
    .route-name {
      font-size: 22px;
      font-weight: 800;
      color: #14532d;
      margin: 0 0 12px;
    }
    .trip-details {
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
    }
    .detail-item {
      display: flex;
      flex-direction: column;
    }
    .detail-label {
      font-size: 11px;
      text-transform: uppercase;
      color: #666;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    .detail-value {
      font-size: 16px;
      font-weight: 700;
      color: #14532d;
    }
    .tickets-section {
      padding: 24px 30px;
    }
    .tickets-section h2 {
      font-size: 16px;
      color: #14532d;
      margin: 0 0 16px;
      font-weight: 700;
    }
    .ticket-card {
      background: linear-gradient(135deg, #14532d, #22c55e);
      color: white;
      border-radius: 12px;
      padding: 16px 20px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .ticket-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .seat-badge {
      background: rgba(255, 255, 255, 0.2);
      padding: 8px 14px;
      border-radius: 8px;
      font-weight: 800;
      font-size: 18px;
    }
    .ticket-id {
      font-size: 12px;
      opacity: 0.8;
    }
    .ticket-price {
      font-size: 18px;
      font-weight: 800;
      color: #fde047;
    }
    .summary {
      background: #f0fdf4;
      padding: 20px 30px;
      border-top: 1px solid #e0e0e0;
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .summary-label {
      font-size: 14px;
      color: #666;
    }
    .summary-value {
      font-size: 24px;
      font-weight: 900;
      color: #22c55e;
    }
    .footer {
      padding: 20px 30px;
      text-align: center;
      color: #999;
      font-size: 12px;
    }
    .footer p {
      margin: 4px 0;
    }
    .passenger-info {
      padding: 16px 30px;
      background: #fff;
      border-bottom: 1px solid #e0e0e0;
    }
    .passenger-name {
      font-size: 14px;
      color: #333;
    }
    .passenger-name strong {
      color: #14532d;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🚌 SIDAROCO</h1>
      <p>Your tickets are ready!</p>
    </div>

    <div class="trip-info">
      <h2 class="route-name">{{routeName}}</h2>
      <div class="trip-details">
        <div class="detail-item">
          <span class="detail-label">Date</span>
          <span class="detail-value">{{travelDate}}</span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Departure</span>
          <span class="detail-value">{{travelTime}}</span>
        </div>
      </div>
    </div>

    <div class="passenger-info">
      <p class="passenger-name">Passenger: <strong>{{passengerName}}</strong></p>
    </div>

    <div class="tickets-section">
      <h2>Your Tickets</h2>
      {{#each tickets}}
      <div class="ticket-card">
        <div class="ticket-left">
          <span class="seat-badge">Seat {{this.seatNumber}}</span>
          <span class="ticket-id">Ticket #{{this.id}}</span>
        </div>
        <span class="ticket-price">${{this.price}}</span>
      </div>
      {{/each}}
    </div>

    <div class="summary">
      <div class="summary-row">
        <span class="summary-label">Total Paid</span>
        <span class="summary-value">${{totalPrice}}</span>
      </div>
    </div>

    <div class="footer">
      <p>Please arrive at least 15 minutes before departure.</p>
      <p>Present this email or your ticket ID at the terminal.</p>
      <p>© 2026 SIDAROCO Transportation</p>
    </div>
  </div>
</body>
</html>