generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Driver{
  id Int @id @default(autoincrement())
  name String
  licenseNumber String @map("license_number") @unique
  birdthDate DateTime @map("birth_date")
  address String
  status String
  photoKey String @map("photo_key")
  accountId String? @map("account_id")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  @@map("drivers")
}

model Bus{
  id Int @id @default(autoincrement())
  name String
  model String
  vin String @unique
  plateNumber String @map("plate_number") @unique
  capacity Int
  status String
  photoKey String @map("photo_key")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt
  routeId Int? @map("route_id")

  @@map("buses")
}