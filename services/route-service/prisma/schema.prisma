// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Route {
  id            Int      @id @default(autoincrement())
  name          String

  originId      Int
  destinationId Int

  origin        Location @relation("RouteOrigin", fields: [originId], references: [id])
  destination   Location @relation("RouteDestination", fields: [destinationId], references: [id])

  ticketPrice   Float? 

  featured      Boolean  @default(false)  
  photoKey      String?  @map("photo_key") 


  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([originId, destinationId], name: "route_origin_destination_unique")
}

model Location {
  id             Int      @id @default(autoincrement())
  name           String
  lat            Float
  lng            Float

  originOf       Route[] @relation("RouteOrigin")
  destinationOf  Route[] @relation("RouteDestination")

  @@unique([name, lat, lng], name: "location_name_lat_lng_unique")
}
