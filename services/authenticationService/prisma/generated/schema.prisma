generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  RouteManager
  Customer
  FinanceManager
  Cashier
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  userType     UserType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}
